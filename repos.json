{
  "repositories": [
    {
      "name": "retro-lab",
      "path": ".",
      "role": "orchestration",
      "description": "Parent repo — AGENTS.md, commands, skills, sub-agents, hooks, docs"
    },
    {
      "name": "retro-api",
      "path": "repos/retro-api",
      "gitUrl": "https://github.com/IslamFathyy/retro-api.git",
      "defaultBranch": "main",
      "role": "backend",
      "description": "Node.js Express API, local JSON/Markdown storage",
      "start": "npm start",
      "port": 3001
    },
    {
      "name": "retro-web",
      "path": "repos/retro-web",
      "gitUrl": "https://github.com/IslamFathyy/retro-web.git",
      "defaultBranch": "main",
      "role": "frontend",
      "description": "HTML/CSS/Vanilla JS UI",
      "start": "npm start",
      "port": 8080
    }
  ],
  "cloneScript": "./clone-repos.sh"
}
