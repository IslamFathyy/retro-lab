{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "node .cursor/hooks/block-dangerous-command.js" }
    ],
    "afterFileEdit": [
      { "command": "node .cursor/hooks/validate-json.js" }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/log-task-subagent.js"
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/log-subagent-stop.js"
      }
    ]
  }
}
