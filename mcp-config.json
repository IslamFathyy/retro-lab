{
  "mcpServers": {
    "readme-doctor": {
      "command": "node",
      "args": ["${workspaceFolder}/plugins/readme-doctor/dist/mcp-server.js"]
    },
    "google-drive": {
      "command": "${env:MCP_NPX_PATH}",
      "args": ["-y", "@piotr-agier/google-drive-mcp"],
      "env": {
        "GOOGLE_DRIVE_OAUTH_KEYS_DIR": "${env:GOOGLE_DRIVE_OAUTH_KEYS_DIR}"
      }
    },
    "gmail": {
      "type": "http",
      "url": "https://gmailmcp.googleapis.com/mcp/v1"
    },
    "github": {
      "url": "https://api.github.com/mcp/"
    }
  }
}
