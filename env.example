# Retrospective Lab — MCP and optional integrations
# Copy to .env (gitignored), then run: .\scripts\setup-mcp.ps1
# Restart Cursor after any change to .env or mcp-config.json

# --- MCP launcher ---
# Windows: use full path to npx.cmd (spaces OK), e.g. C:\Program Files\nodejs\npx.cmd
# macOS/Linux: npx
MCP_NPX_PATH=npx

# --- Google Drive MCP (@piotr-agier/google-drive-mcp) ---
# Directory containing gcp-oauth.keys.json (never commit that file)
# Default on Windows: %USERPROFILE%\.config\google-drive-mcp
GOOGLE_DRIVE_OAUTH_KEYS_DIR=

# --- GitHub MCP (optional) ---
# Default retro-lab setup uses OAuth via remote URL in mcp-config.json.
# Set only if you switch to PAT/header auth in a local mcp-config override.
# GITHUB_TOKEN=

# --- Lokka / Microsoft 365 (optional, personal — not in project mcp-config.json) ---
# Configure in user ~/.cursor/mcp.json instead. Reference only:
# LOKKA_TENANT_ID=
# LOKKA_CLIENT_ID=
# LOKKA_USE_INTERACTIVE=true
